# Copy this file to `.env` and fill in the values. Never commit `.env`.

# --- Django ---
# Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
SECRET_KEY=change-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
# Comma-separated, with scheme. Needed in production, e.g. https://your-project.vercel.app
CSRF_TRUSTED_ORIGINS=

# --- Supabase (PostgreSQL) ---
# Leave both empty to use a local SQLite file (db.sqlite3).
#
# Where to find these: Supabase dashboard -> your project -> "Connect" button
# (top bar) -> "Connection string" -> choose "URI". Replace [YOUR-PASSWORD] with
# the database password you set when creating the project
# (Project Settings -> Database -> "Reset database password" if you forgot it).
#
# DATABASE_URL: Transaction pooler (port 6543). Used by the running app / Vercel.
DATABASE_URL=
# DIRECT_DATABASE_URL: used only for migrations when USE_DIRECT_DB=1.
# Use the Session pooler string (port 5432); the "Direct connection" host is
# IPv6-only on many plans and often fails on home networks.
DIRECT_DATABASE_URL=
USE_DIRECT_DB=0

# --- E-mail (password reset + e-mail verification) ---
# Leave EMAIL_HOST empty to keep these features off in production (they stay
# hidden). In local DEBUG mode e-mails are printed to the console instead.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=Kararsızım <noreply@example.com>
# True: users must verify their e-mail before creating polls or voting.
REQUIRE_VERIFIED_EMAIL=False
